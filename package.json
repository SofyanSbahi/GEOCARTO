{
  "name": "geocarto",
  "version": "3.0.0-dev",
  "private": true,
  "type": "module",
  "description": "GéoCarto — plateforme d'enseignement de la cartographie topographique (moteurs + expériences Learning / Stage)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "golden": "node tools/make-golden.mjs",
    "build": "sh build.sh",
    "check:dist": "sh build.sh && git diff --exit-code -- dist/app.js",
    "gate:stage": "node tools/stage/stage_gate.mjs",
    "audit:geology": "node tools/stage/audit_geology.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
